# Version
VERSION=2.0.0

# Build number
BUILD_NUMBER=1

# Product Name
PRODUCT_NAME="Next-Exam-Teacher"

# Additional Info
INFO="Release"

# Client Directory
CLIENT_DIRECTORY="EXAM-TEACHER"

# Server API Port
SERVER_API_PORT=22422

# Multicast Client Port
MULTICAST_CLIENT_PORT=6024

# Multicast Server Client Port
MULTICAST_SERVER_CLIENT_PORT=6025

# BIP Integration
BIP_INTEGRATION=true

# BIP Demo
BIP_API_URL="https://www.bildung.gv.at/webservice/rest/next-exam/teacher"

# Is Puavo Flavor
IS_PUAVO=false

# Sign and Notarize
SIGN=true

# Exam Modes
EXAMMODE_RDP=true
EXAMMODE_WEBSITE=true
EXAMMODE_GFORMS=true
EXAMMODE_EDUVIDUAL=true
EXAMMODE_EDITOR=true
EXAMMODE_MATH=true
EXAMMODE_MICROSOFT365=true
EXAMMODE_ACTIVESHEETS=true

# Show Devtools
SHOWDEVTOOLS=true

# Development mode
DEVELOPMENT=true

